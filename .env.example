# Copy to .env.local for local overrides. Nothing here is a secret:
# private keys live in the token service, never in this app.

# Sub-path when the app is hosted under a project site, e.g. /spindle/
# Leave unset when it is served from the root of a domain.
# BASE_PATH=/spindle/

# Streaming jukebox (Milestone 7, see docs/STREAMING.md)
# VITE_APPLE_MUSIC_TOKEN_URL=
# VITE_SPOTIFY_CLIENT_ID=
